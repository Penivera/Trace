# Copy to .env.local and fill in. Never commit real values.

# ── Server-only ──────────────────────────────────────────────
# Base URL of the TRACE backend API. Requests from the browser to /api/*
# are proxied here by next.config.ts (read at build time).
API_BASE_URL=http://localhost:8080

# Signs the session cookie: 32+ random characters, required everywhere
# (sign-in is switched off without it). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# MOCK until the backend's auth endpoints exist: one shared demo login for the
# team. Leave either empty to switch demo login off. Never commit real values;
# share them privately (password manager, DM).
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=

# ── Public (inlined into the browser bundle at build time) ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
