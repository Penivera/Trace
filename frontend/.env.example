# Copy to .env.local and fill in. Never commit real values.

# ── Server-only ──────────────────────────────────────────────
# Base URL of the TRACE backend API. Requests from the browser to /api/*
# are proxied here by next.config.ts (read at build time).
API_BASE_URL=http://localhost:8080

# Signs the session cookie. Required in production (32+ random characters);
# without it, sign-in is switched off there. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# MOCK until the backend's auth endpoints exist: one shared demo login for the
# team. These are the local defaults; in production set your own, or leave them
# unset to switch demo login off.
DEMO_LOGIN_EMAIL=agent@trace.demo
DEMO_LOGIN_PASSWORD=TraceAgent#2026

# ── Public (inlined into the browser bundle at build time) ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
